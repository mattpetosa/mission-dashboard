# Cached Launch Library 2 responses and proxied mission imagery. Refetched on
# demand; the cache exists to stay inside LL2's rate limit, not to be kept.
cache/

venv/
__pycache__/
*.py[cod]

# Hipparcos catalog, downloaded by tools/build_stars.py -- ~50MB source
# data, not something the repo needs to track. Only its baked output,
# www/assets/stars.js, is committed.
hip_main.dat
